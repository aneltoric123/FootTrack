@model FootTrack.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<div class="container py-5">
    @if (Model.NajEkipa != null)
    {
        <div class="card shadow-lg border-0 rounded-4 mb-5">
            <div class="card-body p-4">

                <h2 class="fw-bold mb-3 text-center text-dark">
                    Latest Results From <span class="text-primary">@Model.NajEkipa.Ime</span>
                </h2>

                <div class="text-center mb-4">
                    <span class="badge bg-primary fs-5 px-4 py-2">@Model.NajEkipa.Ime</span>
                </div>
                @if (Model.Tekme.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Date</th>
                                    <th class="text-center">Competition</th>
                                    <th class="text-center">Home Team</th>
                                    <th class="text-center">Score</th>
                                    <th class="text-center">Away Team</th>
                                    <th class="text-center">Stadium</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tekma in Model.Tekme)
                                {
                                    var isHome = tekma.DomacaEkipaId == Model.NajEkipa.EkipaId;
                                    var goalsFor = isHome ? tekma.GoliDomaci : tekma.GoliGosti;
                                    var goalsAgainst = isHome ? tekma.GoliGosti : tekma.GoliDomaci;

                                    string scoreClass = goalsFor > goalsAgainst ? "bg-success text-white rounded px-2 py-1" :
                                                        goalsFor == goalsAgainst ? "bg-warning text-dark rounded px-2 py-1" :
                                                        "bg-danger text-white rounded px-2 py-1";
                                <tr>
                                    <td class="fw-semibold">@tekma.Datum.ToString("dd.MM.yyyy")</td>
                                    <td class="text-center">@tekma.Krog.Sezona.Tekmovanje.Ime</td>
                                    <td class="text-center">@tekma.DomacaEkipa.Ime</td>
                                    <td class="text-center">
                                        <a asp-controller="Tekma" asp-action="Details" asp-route-id="@tekma.TekmaId" class="@scoreClass text-decoration-none">
                                            @tekma.GoliDomaci : @tekma.GoliGosti
                                        </a>
                                    </td>
                                    <td class="text-center">@tekma.GostujocaEkipa.Ime</td>
                                    <td class="text-center">@tekma.Stadion?.Ime</td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-center text-muted mb-0">No matches found for this team.</p>
                }
            </div>
        </div>
    }
    
</div>
