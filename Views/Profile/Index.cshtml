@model FootTrack.Models.Uporabnik

<div class="container mt-5">
    <h2 class="mb-4">👤 My Profile</h2>
    <div class="card shadow-sm p-4">
        <p><strong>Username:</strong> @Model.UporabniskoIme</p>
        <p><strong>Email:</strong> @Model.Email</p>
        @if (Model.NajljubsaEkipa != null){
        <p><strong>Favourite Team:</strong> @Model.NajljubsaEkipa.Ime</p>
        }
        else{
            <p><strong>Favourite team:</strong> <em>No favourite team selected</em></p>
        }
        <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
    <button type="submit" class="btn btn-danger mt-3">Logout</button>
    </form>
    <form id = "deleteForm" asp-area="Identity" asp-action="Delete" method="post">
    <button type="submit" class="btn btn-danger mt-3">Delete Account</button>
@Html.AntiForgeryToken()
</form>
    </div>
</div>
