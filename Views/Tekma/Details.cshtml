@model FootTrack.Models.ViewModels.TekmaDetailsViewModel
<link rel="stylesheet" href="~/css/details.css"/>

@if (Model?.Tekma == null)
{
    <div class="alert alert-danger text-center">
        Match data not available.
    </div>
    return;
}

<div class="match-details">
    <p class="game-header">
        @Model.Tekma.Krog?.Sezona?.Tekmovanje?.Drzava
        • @Model.Tekma.Krog?.Sezona?.Tekmovanje?.Ime
        • Round @Model.Tekma.Krog?.Stevilka
    </p>

    <p class="small-details">
        📅 @Model.Tekma.Datum.ToString("dd.MM.yyyy HH:mm")
        &nbsp;|&nbsp;
        🏟 @(Model.Tekma.Stadion?.Ime ?? "Unknown stadium")
        (@Model.Tekma.Stadion?.Mesto?.Ime,
         @Model.Tekma.Stadion?.Mesto?.Drzava?.Ime)
    </p>
</div>

<h1 class="game-title">
    <span class="team home">@Model.Tekma.DomacaEkipa?.Ime</span>
    <span class="score">@Model.Tekma.GoliDomaci : @Model.Tekma.GoliGosti</span>
    <span class="team away">@Model.Tekma.GostujocaEkipa?.Ime</span>
</h1>

<h2 class="match-header">⚽ Match Events</h2>

<div class="events">
    @if (Model.Dogodki == null || !Model.Dogodki.Any())
    {
        <p class="text-muted text-center">No match events recorded.</p>
    }
    else
    {
        <ul>
            @foreach (var d in Model.Dogodki)
            {
                <li class="event">
                    <span class="minute">@d.Minuta'</span>
                    <span class="player">
                        @(d.Igralec != null
                            ? $"{d.Igralec.Ime} {d.Igralec.Priimek}"
                            : "Unknown player")
                    </span>
                    <span class="event-type">@d.TipDogodka</span>
                </li>
            }
        </ul>
    }
</div>
