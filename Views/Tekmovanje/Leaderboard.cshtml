@model List<FootTrack.Models.EkipaVSezoni>

<h2>Leaderboard</h2>
<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Position</th>
            <th>Team</th>
            <th>Points</th>
            <th>Wins</th>
            <th>Draws</th>
            <th>Losses</th>
            <th>Goals</th>
            <th>Goals Conceded</th>
            <th>Goal Difference</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.Count; i++)
        {
            <tr>
                <td>@(i + 1)</td>
                <td>@Model[i].Ekipa.Ime</td>
                <td>@Model[i].Tocke</td>
                <td>@Model[i].Zmage</td>
                <td>@Model[i].Remi</td>
                <td>@Model[i].Porazi</td>
                <td>@Model[i].Goli</td>
                <td>@Model[i].Prejeti_Goli</td>
                <td>@(Model[i].Goli - Model[i].Prejeti_Goli)</td>
            </tr>
        }
    </tbody>
</table>
